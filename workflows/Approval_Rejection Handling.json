    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  throw new Error('No pending invoice found.');\n}\n\nconst latest = items.reduce((latest, current) => {\n  const latestId = Number(latest.json.id || 0);\n  const currentId = Number(current.json.id || 0);\n\n  return currentId > latestId ? current : latest;\n});\n\nreturn [latest];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
